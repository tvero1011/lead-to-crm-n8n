    {
      "parameters": {
        "jsCode": "// Each incoming item is one PAGE of results. Flatten all pages, then group by email.\nconst contacts = $input.all().flatMap(page => page.json.results ?? []);\nconst byEmail = {};\nfor (const c of contacts) {\n  const email = (c.properties?.email ?? '').toLowerCase().trim();\n  if (!email) continue;\n  (byEmail[email] ||= []).push(c.id);\n}\nconst duplicates = Object.entries(byEmail)\n  .filter(([, ids]) => ids.length > 1)\n  .map(([email, ids]) => ({ email, contactIds: ids }));\nreturn [{ json: { pagesFetched: $input.all().length, totalContacts: contacts.length, duplicateCount: duplicates.length, duplicates } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
