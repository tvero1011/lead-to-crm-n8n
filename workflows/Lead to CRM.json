      "parameters": {
        "jsCode": "// Check the incoming data and tidy it up before anything else happens.\nconst body = $input.first().json.body ?? {};\nconst clean = (v) => (typeof v === 'string' ? v.trim() : '');\nconst titleCase = (s) => s.toLowerCase().replace(/\\b\\w/g, (c) => c.toUpperCase());\nconst errors = [];\n\nconst email = clean(body.email).toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('A valid email is required');\n\nconst fullName = titleCase(clean(body.name));\nif (!fullName) errors.push('Name is required');\n\nconst message = clean(body.message);\nif (message.length < 5) errors.push('Message must be at least 5 characters');\n\nconst parts = fullName.split(/\\s+/).filter(Boolean);\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors,\n  lead: {\n    email,\n    fullName,\n    firstName: parts[0] ?? '',\n    lastName: parts.slice(1).join(' '),\n    company: clean(body.company),\n    message,\n    source: clean(body.source) || 'website',\n  },\n}}];"
      },
